<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="PoliticalApp.Views.HomePage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:PoliticalApp.ViewModels"
             xmlns:models="clr-namespace:PoliticalApp.Models"
             x:DataType="viewModels:HomeViewModel"
             BackgroundColor="{StaticResource BackgroundColor}">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="24,16"
                                 Spacing="24">
                <!-- Header Section -->
                <VerticalStackLayout Spacing="4">
                    <Label Text="Your Civic Hub"
                           Style="{StaticResource TitleLabelStyle}" />
                    <Label Text="Stay informed and engaged"
                           Style="{StaticResource CaptionLabelStyle}" />
                </VerticalStackLayout>

                <!-- Statistics Section -->
                <VerticalStackLayout Spacing="12">
                    <Label Text="Your Activity"
                           Style="{StaticResource HeadlineLabelStyle}" />

                    <CollectionView ItemsSource="{Binding Stats}"
                                    SelectionMode="None">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal"
                                               ItemSpacing="12" />
                        </CollectionView.ItemsLayout>

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:CivicStat">
                                <Frame Style="{StaticResource CardFrameStyle}"
                                       WidthRequest="180">
                                    <VerticalStackLayout Spacing="8"
                                                         HorizontalOptions="Center">
                                        <Label Text="{Binding Icon}"
                                               FontSize="36"
                                               HorizontalTextAlignment="Center" />
                                        <Label Text="{Binding Value}"
                                               Style="{StaticResource HeadlineLabelStyle}"
                                               HorizontalTextAlignment="Center"
                                               Margin="0" />
                                        <Label Text="{Binding Label}"
                                               Style="{StaticResource CaptionLabelStyle}"
                                               HorizontalTextAlignment="Center" />
                                    </VerticalStackLayout>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <!-- Recent Votes Section -->
                <VerticalStackLayout Spacing="12">
                    <Label Text="Recent Votes"
                           Style="{StaticResource HeadlineLabelStyle}" />

                    <CollectionView ItemsSource="{Binding RecentVotes}"
                                    SelectionMode="None">
                        <CollectionView.EmptyView>
                            <VerticalStackLayout Padding="12"
                                                 Spacing="4">
                                <Label Text="No recent votes yet."
                                       Style="{StaticResource BodyLabelStyle}"
                                       HorizontalTextAlignment="Center" />
                                <Label Text="Engage with policies to see them here."
                                       Style="{StaticResource CaptionLabelStyle}"
                                       HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Policy">
                                <Frame Style="{StaticResource CardFrameStyle}">
                                    <Grid ColumnDefinitions="*,Auto"
                                          ColumnSpacing="12">
                                        <VerticalStackLayout Grid.Column="0"
                                                             Spacing="4">
                                            <Label Text="{Binding BillNumber}"
                                                   Style="{StaticResource CaptionLabelStyle}"
                                                   TextColor="{StaticResource PrimaryColor}"
                                                   FontAttributes="Bold" />
                                            <Label Text="{Binding Title}"
                                                   Style="{StaticResource SubheadLabelStyle}"
                                                   Margin="0" />
                                            <Label Text="{Binding UserVote}"
                                                   Style="{StaticResource BodyLabelStyle}"
                                                   FontAttributes="Bold">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label"
                                                                 Binding="{Binding UserVote}"
                                                                 Value="Yea">
                                                        <Setter Property="TextColor"
                                                                Value="{StaticResource SuccessColor}" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label"
                                                                 Binding="{Binding UserVote}"
                                                                 Value="Nay">
                                                        <Setter Property="TextColor"
                                                                Value="{StaticResource ErrorColor}" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label"
                                                                 Binding="{Binding UserVote}"
                                                                 Value="Abstain">
                                                        <Setter Property="TextColor"
                                                                Value="{StaticResource TextSecondaryColor}" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </VerticalStackLayout>

                                        <Label Grid.Column="1"
                                               Text="{Binding VoteDeadline, StringFormat='Vote by {0:MMM dd, yyyy}'}"
                                               Style="{StaticResource CaptionLabelStyle}"
                                               HorizontalTextAlignment="End"
                                               VerticalOptions="Start"
                                               Margin="0"
                                               IsVisible="{Binding VoteDeadline, Converter={StaticResource NullableToBoolConverter}}" />
                                    </Grid>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Button Text="View All Policies"
                            Command="{Binding NavigateToPoliciesCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" />
                </VerticalStackLayout>

                <!-- Quick Actions Section -->
                <VerticalStackLayout Spacing="12">
                    <Label Text="Quick Actions"
                           Style="{StaticResource HeadlineLabelStyle}" />

                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="12">
                        <Button Text="Find Representatives"
                                Command="{Binding NavigateToRepresentativesCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Grid.Column="0" />
                        <Button Text="Take Alignment Quiz"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Grid.Column="1"
                                IsEnabled="False" />
                    </Grid>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <ActivityIndicator IsVisible="{Binding IsLoading}"
                           IsRunning="{Binding IsLoading}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Color="{StaticResource PrimaryColor}" />
    </Grid>
</ContentPage>
