<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="PoliticalApp.Views.HomePage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:PoliticalApp.ViewModels"
             xmlns:models="clr-namespace:PoliticalApp.Models"
             x:DataType="viewModels:HomeViewModel"
             BackgroundColor="{StaticResource BackgroundColor}">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="24,16"
                                 Spacing="24">
                <!-- Header Section -->
                <VerticalStackLayout Spacing="4">
                    <Label Text="Your Civic Hub"
                           Style="{StaticResource TitleLabelStyle}" />
                    <Label Text="Stay informed and engaged"
                           Style="{StaticResource CaptionLabelStyle}" />
                </VerticalStackLayout>

                <!-- Statistics Section -->
                <VerticalStackLayout Spacing="12">
                    <Label Text="Your Activity"
                        Style="{StaticResource HeadlineLabelStyle}" />

                    <CollectionView ItemsSource="{Binding Stats}"
                                    SelectionMode="None">
                        
                        <!-- Vertical list -->
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical"
                                            ItemSpacing="12" />
                        </CollectionView.ItemsLayout>

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:CivicStat">
                                <Frame Style="{StaticResource CardFrameStyle}"
                                    Padding="16"
                                    Margin="4, 4, 4, 4">

                                    <!-- Horizontal content inside each card -->
                                    <Grid ColumnDefinitions="Auto, *"
                                        ColumnSpacing="16"
                                        VerticalOptions="Center">

                                        <!-- ICON -->
                                        <Label Text="{Binding Icon}"
                                            FontSize="36"
                                            VerticalOptions="Center"
                                            HorizontalOptions="Start" />

                                        <!-- VALUE + LABEL -->
                                        <VerticalStackLayout Grid.Column="1"
                                                            Spacing="2"
                                                            VerticalOptions="Center">

                                            <Label Text="{Binding Value}"
                                                Style="{StaticResource HeadlineLabelStyle}"
                                                HorizontalTextAlignment="Start"
                                                Margin="0" />

                                            <Label Text="{Binding Label}"
                                                Style="{StaticResource CaptionLabelStyle}"
                                                HorizontalTextAlignment="Start" />
                                        </VerticalStackLayout>

                                    </Grid>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>


                <!-- Quick Actions Section -->
                <VerticalStackLayout Spacing="12">
                    <Label Text="Quick Actions"
                           Style="{StaticResource HeadlineLabelStyle}" />

                    <Button Text="View Bills and Policies"
                            Command="{Binding NavigateToPoliciesCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" />
                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="12">
                        <Button Text="Find Representatives"
                                Command="{Binding NavigateToRepresentativesCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Grid.Column="0" />
                        <Button Text="Take Alignment Quiz"
                                Command="{Binding NavigateToQuizCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Grid.Column="1" />
                    </Grid>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <ActivityIndicator IsVisible="{Binding IsLoading}"
                           IsRunning="{Binding IsLoading}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Color="{StaticResource PrimaryColor}" />
    </Grid>
</ContentPage>
