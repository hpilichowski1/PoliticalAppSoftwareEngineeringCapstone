<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PoliticalApp.Views.ProfilePage"
             Title="Profile">

    <ContentPage.Resources>

        <!-- Card style -->
        <Style x:Key="CardFrameStyle" TargetType="Frame">
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="HasShadow" Value="True" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="BackgroundColor" Value="{DynamicResource CardBackgroundColor}" />
        </Style>

        <!-- Section title -->
        <Style x:Key="SectionTitleLabel" TargetType="Label">
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="TextColor" Value="{DynamicResource PrimaryTextColor}" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <!-- Subtitle label -->
        <Style x:Key="SubLabel" TargetType="Label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextColor" Value="{DynamicResource SecondaryTextColor}" />
        </Style>

        <!-- Vote pill border -->
        <Style x:Key="VotePillBorder" TargetType="Border">
            <Setter Property="StrokeShape">
                <Setter.Value>
                    <RoundRectangle CornerRadius="20" />
                </Setter.Value>
            </Setter>
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="HorizontalOptions" Value="End" />
        </Style>

    </ContentPage.Resources>


    <!-- ======================= -->
    <!-- MAIN CONTENT -->
    <!-- ======================= -->
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <!-- PROFILE CARD -->
            <Frame Style="{StaticResource CardFrameStyle}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Profile" Style="{StaticResource SectionTitleLabel}" />
                    <Label Text="Email" Style="{StaticResource SubLabel}" />
                    <Label Text="{Binding Email}" FontSize="14" />
                    <Label Text="Alignment Score" Style="{StaticResource SubLabel}" />
                   <Label Text="{Binding AlignmentScore, StringFormat='{}{0}%'}" FontSize="18" FontAttributes="Bold"/>

                </VerticalStackLayout>
            </Frame>

            <!-- LOCATION SETTINGS CARD -->
            <Frame Style="{StaticResource CardFrameStyle}">
                <VerticalStackLayout Spacing="12">

                    <Label Text="Location" Style="{StaticResource SectionTitleLabel}" />

                    <VerticalStackLayout>
                        <Label Text="State" Style="{StaticResource SubLabel}" />
                        <Entry Text="{Binding State}" Placeholder="e.g. FL" />
                    </VerticalStackLayout>

                    <VerticalStackLayout>
                        <Label Text="Region / District" Style="{StaticResource SubLabel}" />
                        <Entry Text="{Binding Region}" Placeholder="e.g. 2" />
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Text="Save Location"
                                Grid.Column="0"
                                Command="{Binding SaveLocationCommand}" />

                        <Button Text="Get Representatives"
                                Grid.Column="1"
                                Command="{Binding LoadRepresentativesCommand}" />
                    </Grid>
                </VerticalStackLayout>
            </Frame>


            <!-- REPRESENTATIVES CARD -->
            <Frame Style="{StaticResource CardFrameStyle}">
                <VerticalStackLayout Spacing="8">

                    <Label Text="Your Representatives" Style="{StaticResource SectionTitleLabel}" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Representatives}"
                                         Spacing="10">

                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{Binding Name}"
                                           FontAttributes="Bold"
                                           FontSize="14" />

                                    <Label Text="{Binding Office}"
                                           FontSize="12"
                                           TextColor="{DynamicResource SecondaryTextColor}" />

                                    <Label Text="{Binding Party}"
                                           FontSize="12"
                                           TextColor="{DynamicResource SecondaryTextColor}" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Frame>


            <!-- USER VOTES CARD -->
            <Frame Style="{StaticResource CardFrameStyle}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Your Votes" Style="{StaticResource SectionTitleLabel}" />

                    <!-- Votes List -->
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Votes}"
                                         Spacing="12">

                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,Auto"
                                      RowDefinitions="Auto,Auto"
                                      Padding="0,4">

                                    <!-- BILL TITLE -->
                                    <Label Text="{Binding BillTitle}"
                                           Grid.Row="0"
                                           Grid.ColumnSpan="2"
                                           FontAttributes="Bold"
                                           FontSize="14"
                                           LineBreakMode="WordWrap" />

                                    <!-- Vote pill -->
                                    <Border Grid.Row="1"
                                            Grid.Column="1"
                                            Style="{StaticResource VotePillBorder}">

                                        <Border.BackgroundColor>
                                            <Binding Path="Vote" Converter="{StaticResource VoteToColorConverter}" />
                                        </Border.BackgroundColor>


                                        <Label Text="{Binding Vote}"
                                               FontAttributes="Bold"
                                               FontSize="12"
                                               TextColor="White" />
                                    </Border>

                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Frame>


        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
