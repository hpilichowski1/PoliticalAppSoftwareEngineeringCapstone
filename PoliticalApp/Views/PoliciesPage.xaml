<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="PoliticalApp.Views.PoliciesPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:PoliticalApp.ViewModels"
             xmlns:models="clr-namespace:PoliticalApp.Models"
             x:DataType="viewModels:PoliciesViewModel"
             BackgroundColor="{StaticResource BackgroundColor}">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="24,16"
                                 Spacing="24">
                <!-- Header Section -->
                <VerticalStackLayout Spacing="4">
                    <Label Text="Policy Hub"
                           Style="{StaticResource TitleLabelStyle}" />
                    <Label Text="Vote on upcoming bills and track legislation"
                           Style="{StaticResource CaptionLabelStyle}" />
                </VerticalStackLayout>

                <!-- Filter Section -->
                <VerticalStackLayout Spacing="12">
                    <Label Text="Filter by Category"
                           Style="{StaticResource HeadlineLabelStyle}" />

                    <ScrollView Orientation="Horizontal"
                                HorizontalScrollBarVisibility="Never">
                        <HorizontalStackLayout Spacing="8">
                            <Button Text="All"
                                    Command="{Binding FilterByCategoryCommand}"
                                    CommandParameter="All"
                                    Style="{StaticResource SecondaryButtonStyle}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button"
                                                 Binding="{Binding SelectedCategory}"
                                                 Value="All">
                                        <Setter Property="BackgroundColor"
                                                Value="{StaticResource PrimaryColor}" />
                                        <Setter Property="TextColor"
                                                Value="White" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>

                            <Button Text="Education"
                                    Command="{Binding FilterByCategoryCommand}"
                                    CommandParameter="Education"
                                    Style="{StaticResource SecondaryButtonStyle}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button"
                                                 Binding="{Binding SelectedCategory}"
                                                 Value="Education">
                                        <Setter Property="BackgroundColor"
                                                Value="{StaticResource PrimaryColor}" />
                                        <Setter Property="TextColor"
                                                Value="White" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>

                            <Button Text="Healthcare"
                                    Command="{Binding FilterByCategoryCommand}"
                                    CommandParameter="Healthcare"
                                    Style="{StaticResource SecondaryButtonStyle}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button"
                                                 Binding="{Binding SelectedCategory}"
                                                 Value="Healthcare">
                                        <Setter Property="BackgroundColor"
                                                Value="{StaticResource PrimaryColor}" />
                                        <Setter Property="TextColor"
                                                Value="White" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>

                            <Button Text="Transportation"
                                    Command="{Binding FilterByCategoryCommand}"
                                    CommandParameter="Transportation"
                                    Style="{StaticResource SecondaryButtonStyle}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button"
                                                 Binding="{Binding SelectedCategory}"
                                                 Value="Transportation">
                                        <Setter Property="BackgroundColor"
                                                Value="{StaticResource PrimaryColor}" />
                                        <Setter Property="TextColor"
                                                Value="White" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>

                            <Button Text="Environment"
                                    Command="{Binding FilterByCategoryCommand}"
                                    CommandParameter="Environment"
                                    Style="{StaticResource SecondaryButtonStyle}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button"
                                                 Binding="{Binding SelectedCategory}"
                                                 Value="Environment">
                                        <Setter Property="BackgroundColor"
                                                Value="{StaticResource PrimaryColor}" />
                                        <Setter Property="TextColor"
                                                Value="White" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>

                            <Button Text="Public Safety"
                                    Command="{Binding FilterByCategoryCommand}"
                                    CommandParameter="Public Safety"
                                    Style="{StaticResource SecondaryButtonStyle}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button"
                                                 Binding="{Binding SelectedCategory}"
                                                 Value="Public Safety">
                                        <Setter Property="BackgroundColor"
                                                Value="{StaticResource PrimaryColor}" />
                                        <Setter Property="TextColor"
                                                Value="White" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>

                            <Button Text="Housing"
                                    Command="{Binding FilterByCategoryCommand}"
                                    CommandParameter="Housing"
                                    Style="{StaticResource SecondaryButtonStyle}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button"
                                                 Binding="{Binding SelectedCategory}"
                                                 Value="Housing">
                                        <Setter Property="BackgroundColor"
                                                Value="{StaticResource PrimaryColor}" />
                                        <Setter Property="TextColor"
                                                Value="White" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                        </HorizontalStackLayout>
                    </ScrollView>
                </VerticalStackLayout>

                <!-- Level Filter Section -->
                <VerticalStackLayout Spacing="12">
                    <Label Text="Filter by Level"
                           Style="{StaticResource HeadlineLabelStyle}" />

                    <HorizontalStackLayout Spacing="8">
                        <Button Text="All"
                                Command="{Binding FilterByLevelCommand}"
                                CommandParameter="All"
                                Style="{StaticResource SecondaryButtonStyle}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button"
                                             Binding="{Binding SelectedLevel}"
                                             Value="All">
                                    <Setter Property="BackgroundColor"
                                            Value="{StaticResource PrimaryColor}" />
                                    <Setter Property="TextColor"
                                            Value="White" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>

                        <Button Text="State"
                                Command="{Binding FilterByLevelCommand}"
                                CommandParameter="State"
                                Style="{StaticResource SecondaryButtonStyle}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button"
                                             Binding="{Binding SelectedLevel}"
                                             Value="State">
                                    <Setter Property="BackgroundColor"
                                            Value="{StaticResource PrimaryColor}" />
                                    <Setter Property="TextColor"
                                            Value="White" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>

                        <Button Text="City"
                                Command="{Binding FilterByLevelCommand}"
                                CommandParameter="City"
                                Style="{StaticResource SecondaryButtonStyle}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button"
                                             Binding="{Binding SelectedLevel}"
                                             Value="City">
                                    <Setter Property="BackgroundColor"
                                            Value="{StaticResource PrimaryColor}" />
                                    <Setter Property="TextColor"
                                            Value="White" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <!-- Policies List Section -->
                <VerticalStackLayout Spacing="12">
                    <HorizontalStackLayout Spacing="8"
                                           HorizontalOptions="FillAndExpand">
                        <Label Text="Active Bills"
                               Style="{StaticResource HeadlineLabelStyle}"
                               HorizontalOptions="StartAndExpand" />
                        <Label Text="{Binding FilteredPolicies.Count, StringFormat='{0} bills'}"
                               Style="{StaticResource CaptionLabelStyle}"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <CollectionView ItemsSource="{Binding FilteredPolicies}"
                                    SelectionMode="None">
                        <CollectionView.EmptyView>
                            <VerticalStackLayout Padding="24"
                                                 Spacing="8">
                                <Label Text="📋"
                                       FontSize="48"
                                       HorizontalTextAlignment="Center" />
                                <Label Text="No policies found"
                                       Style="{StaticResource BodyLabelStyle}"
                                       HorizontalTextAlignment="Center"
                                       FontAttributes="Bold" />
                                <Label Text="Try adjusting your filters"
                                       Style="{StaticResource CaptionLabelStyle}"
                                       HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Policy">
                                <Frame Style="{StaticResource CardFrameStyle}">
                                    <VerticalStackLayout Spacing="12">
                                        <!-- Bill Header -->
                                        <Grid ColumnDefinitions="*,Auto"
                                              ColumnSpacing="12">
                                            <VerticalStackLayout Grid.Column="0"
                                                                 Spacing="4">
                                                <Label Text="{Binding BillNumber}"
                                                       Style="{StaticResource CaptionLabelStyle}"
                                                       TextColor="{StaticResource PrimaryColor}"
                                                       FontAttributes="Bold" />
                                                <Label Text="{Binding Title}"
                                                       Style="{StaticResource SubheadLabelStyle}"
                                                       Margin="0" />
                                            </VerticalStackLayout>

                                            <!-- Status Badge -->
                                            <Border Grid.Column="1"
                                                    BackgroundColor="{StaticResource AccentColor}"
                                                    Padding="8,4"
                                                    StrokeShape="RoundRectangle 12"
                                                    Stroke="Transparent"
                                                    VerticalOptions="Start">
                                                <Label Text="{Binding Status}"
                                                       TextColor="White"
                                                       FontSize="11"
                                                       FontAttributes="Bold" />
                                            </Border>
                                        </Grid>

                                        <!-- Category and Level Tags -->
                                        <HorizontalStackLayout Spacing="8">
                                            <Border BackgroundColor="{StaticResource SurfaceColor}"
                                                    Stroke="{StaticResource PrimaryColor}"
                                                    StrokeThickness="1.5"
                                                    Padding="8,4"
                                                    StrokeShape="RoundRectangle 12">
                                                <Label Text="{Binding Category}"
                                                       Style="{StaticResource CaptionLabelStyle}"
                                                       TextColor="{StaticResource PrimaryColor}"
                                                       FontAttributes="Bold"
                                                       FontSize="12" />
                                            </Border>

                                            <Border BackgroundColor="{StaticResource SurfaceColor}"
                                                    Stroke="{StaticResource BorderColor}"
                                                    StrokeThickness="1"
                                                    Padding="8,4"
                                                    StrokeShape="RoundRectangle 12">
                                                <Label Text="{Binding Level}"
                                                       Style="{StaticResource CaptionLabelStyle}"
                                                       FontSize="12" />
                                            </Border>
                                        </HorizontalStackLayout>

                                        <!-- AI-Generated Summary -->
                                        <VerticalStackLayout Spacing="4">
                                            <Label Text="📄 Summary"
                                                   Style="{StaticResource BodyLabelStyle}"
                                                   FontAttributes="Bold"
                                                   FontSize="14" />
                                            <Label Text="{Binding Summary}"
                                                   Style="{StaticResource BodyLabelStyle}"
                                                   LineHeight="1.4"
                                                   FontSize="14" />
                                        </VerticalStackLayout>

                                        <!-- Impact Summary -->
                                        <Frame BackgroundColor="{StaticResource BackgroundColor}"
                                               BorderColor="{StaticResource BorderColor}"
                                               Padding="12"
                                               CornerRadius="8"
                                               HasShadow="False">
                                            <VerticalStackLayout Spacing="4">
                                                <Label Text="💡 Expected Impact"
                                                       Style="{StaticResource BodyLabelStyle}"
                                                       FontAttributes="Bold"
                                                       FontSize="13" />
                                                <Label Text="{Binding ImpactSummary}"
                                                       Style="{StaticResource CaptionLabelStyle}"
                                                       LineHeight="1.4" />
                                            </VerticalStackLayout>
                                        </Frame>

                                        <!-- Sponsor and Deadline Info -->
                                        <Grid ColumnDefinitions="*,Auto"
                                              ColumnSpacing="12">
                                            <Label Grid.Column="0"
                                                   Text="{Binding SponsorName, StringFormat='Sponsored by {0}'}"
                                                   Style="{StaticResource CaptionLabelStyle}"
                                                   VerticalOptions="Center" />

                                            <Label Grid.Column="1"
                                                   Text="{Binding VoteDeadline, StringFormat='Vote by {0:MMM dd}'}"
                                                   Style="{StaticResource CaptionLabelStyle}"
                                                   TextColor="{StaticResource WarningColor}"
                                                   FontAttributes="Bold"
                                                   VerticalOptions="Center"
                                                   IsVisible="{Binding VoteDeadline, Converter={StaticResource NullableToBoolConverter}}" />
                                        </Grid>

                                        <!-- Voting Section -->
                                        <BoxView HeightRequest="1"
                                                 BackgroundColor="{StaticResource BorderColor}"
                                                 Margin="0,4" />

                                        <VerticalStackLayout Spacing="8">
                                            <Label Text="Cast Your Simulated Vote"
                                                   Style="{StaticResource BodyLabelStyle}"
                                                   FontAttributes="Bold"
                                                   FontSize="14" />

                                            <!-- Current Vote Status -->
                                            <Label Text="{Binding UserVote, StringFormat='Your vote: {0}'}"
                                                   Style="{StaticResource CaptionLabelStyle}"
                                                   FontAttributes="Bold"
                                                   IsVisible="{Binding UserVote, Converter={StaticResource NullableToBoolConverter}}">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label"
                                                                 Binding="{Binding UserVote}"
                                                                 Value="Yea">
                                                        <Setter Property="TextColor"
                                                                Value="{StaticResource SuccessColor}" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label"
                                                                 Binding="{Binding UserVote}"
                                                                 Value="Nay">
                                                        <Setter Property="TextColor"
                                                                Value="{StaticResource ErrorColor}" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label"
                                                                 Binding="{Binding UserVote}"
                                                                 Value="Abstain">
                                                        <Setter Property="TextColor"
                                                                Value="{StaticResource TextSecondaryColor}" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>

                                            <!-- Vote Buttons -->
                                            <Grid ColumnDefinitions="*,*,*"
                                                  ColumnSpacing="8">
                                                <!-- Yea Button -->
                                                <Button Grid.Column="0"
                                                        Text="✓ Yea"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:PoliciesViewModel}}, Path=VoteCommand}"
                                                        CommandParameter="{Binding .}"
                                                        BackgroundColor="{StaticResource SuccessColor}"
                                                        TextColor="White"
                                                        CornerRadius="8"
                                                        Padding="8"
                                                        FontSize="14"
                                                        FontAttributes="Bold">
                                                    <Button.Triggers>
                                                        <DataTrigger TargetType="Button"
                                                                     Binding="{Binding UserVote}"
                                                                     Value="Yea">
                                                            <Setter Property="Opacity"
                                                                    Value="1" />
                                                            <Setter Property="BorderColor"
                                                                    Value="White" />
                                                            <Setter Property="BorderWidth"
                                                                    Value="2" />
                                                        </DataTrigger>
                                                    </Button.Triggers>
                                                </Button>

                                                <!-- Nay Button -->
                                                <Button Grid.Column="1"
                                                        Text="✗ Nay"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:PoliciesViewModel}}, Path=VoteNayCommand}"
                                                        CommandParameter="{Binding .}"
                                                        BackgroundColor="{StaticResource ErrorColor}"
                                                        TextColor="White"
                                                        CornerRadius="8"
                                                        Padding="8"
                                                        FontSize="14"
                                                        FontAttributes="Bold">
                                                    <Button.Triggers>
                                                        <DataTrigger TargetType="Button"
                                                                     Binding="{Binding UserVote}"
                                                                     Value="Nay">
                                                            <Setter Property="Opacity"
                                                                    Value="1" />
                                                            <Setter Property="BorderColor"
                                                                    Value="White" />
                                                            <Setter Property="BorderWidth"
                                                                    Value="2" />
                                                        </DataTrigger>
                                                    </Button.Triggers>
                                                </Button>

                                                <!-- Abstain Button -->
                                                <Button Grid.Column="2"
                                                        Text="― Abstain"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:PoliciesViewModel}}, Path=VoteAbstainCommand}"
                                                        CommandParameter="{Binding .}"
                                                        BackgroundColor="{StaticResource TextSecondaryColor}"
                                                        TextColor="White"
                                                        CornerRadius="8"
                                                        Padding="8"
                                                        FontSize="14"
                                                        FontAttributes="Bold">
                                                    <Button.Triggers>
                                                        <DataTrigger TargetType="Button"
                                                                     Binding="{Binding UserVote}"
                                                                     Value="Abstain">
                                                            <Setter Property="Opacity"
                                                                    Value="1" />
                                                            <Setter Property="BorderColor"
                                                                    Value="White" />
                                                            <Setter Property="BorderWidth"
                                                                    Value="2" />
                                                        </DataTrigger>
                                                    </Button.Triggers>
                                                </Button>
                                            </Grid>
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <ActivityIndicator IsVisible="{Binding IsLoading}"
                           IsRunning="{Binding IsLoading}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Color="{StaticResource PrimaryColor}" />
    </Grid>
</ContentPage>
