<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="PoliticalApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:PoliticalApp"
    xmlns:views="clr-namespace:PoliticalApp.Views"
    Title="PoliticalApp"
    FlyoutBehavior="Disabled">

    <TabBar>
        <!-- 👇 changed pages:LoginPage -> views:LoginPage -->
        <ShellContent Route="LoginPage"
                      ContentTemplate="{DataTemplate views:LoginPage}" />
        <ShellContent Route="RegisterPage"
                  ContentTemplate="{DataTemplate views:RegisterPage}" />
    </TabBar>

    <TabBar>
        <Tab Title="Home" Icon="home.png" Route="home">
            <ShellContent
                Title="Home"
                ContentTemplate="{DataTemplate local:MainPage}"
                Route="MainPage" />
        </Tab>
        <Tab Title="Representatives" Icon="people.png" Route="representatives">
            <ShellContent
                Title="Representatives"
                ContentTemplate="{DataTemplate views:RepresentativesPage}"
                Route="RepresentativesPage" />
        </Tab>
        <Tab Title="Policies" Icon="document.png" Route="policies">
            <ShellContent
                Title="Policies"
                ContentTemplate="{DataTemplate views:PoliciesPage}"
                Route="PoliciesPage" />
        </Tab>
        <Tab Title="Profile" Icon="person.png" Route="profile">
            <ShellContent
                Title="Profile"
                ContentTemplate="{DataTemplate ContentPage}"
                Route="ProfilePlaceholder" />
        </Tab>
    </TabBar>

</Shell>
