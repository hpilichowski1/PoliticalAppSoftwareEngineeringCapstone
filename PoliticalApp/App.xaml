<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:PoliticalApp"
             xmlns:converters="clr-namespace:PoliticalApp.Converters"
             x:Class="PoliticalApp.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:NullableToBoolConverter x:Key="NullableToBoolConverter" />
            <converters:ConsistencyScoreToColorConverter x:Key="ConsistencyScoreToColorConverter" />
            <converters:ScoreToProgressConverter x:Key="ScoreToProgressConverter" />
            <converters:VoteToUpColorConverter x:Key="VoteToUpColorConverter"/>
            <converters:VoteToDownColorConverter x:Key="VoteToDownColorConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
