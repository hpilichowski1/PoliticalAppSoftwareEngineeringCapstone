<?xml version="1.0" encoding="utf-8" ?>
<TabbedPage
    x:Class="PoliticalApp.Pages.AuthPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:PoliticalApp.Pages"
    Title="Welcome"
    BarBackgroundColor="{DynamicResource PrimaryColor}"
    BarTextColor="{DynamicResource OnPrimaryColor}"
    Shell.NavBarIsVisible="False">

    <!-- LOGIN TAB -->
    <ContentPage Title="Login">
        <Grid Padding="24" RowDefinitions="Auto,*" BackgroundColor="{AppThemeBinding Light=#F6F6F6, Dark=#121212}">
            <!-- Header -->
            <VerticalStackLayout Spacing="4">
                <Label Text="Welcome back" FontSize="28" FontAttributes="Bold" />
                <Label Text="Sign in to continue" Opacity="0.7" />
            </VerticalStackLayout>

            <!-- Card -->
            <Frame Grid.Row="1" Padding="20" CornerRadius="16" HasShadow="True" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">
                <VerticalStackLayout Spacing="16">

                    <!-- Email -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Email" FontAttributes="Bold" />
                        <Entry x:Name="LoginEmailEntry"
                               Placeholder="you@example.com"
                               Keyboard="Email"
                               Text="{Binding LoginEmail}"
                               ClearButtonVisibility="WhileEditing" />
                    </VerticalStackLayout>

                    <!-- Password -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Password" FontAttributes="Bold" />
                        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                            <Entry x:Name="LoginPasswordEntry"
                                   Placeholder="••••••••"
                                   IsPassword="{Binding IsLoginPasswordHidden, Mode=TwoWay}"
                                   Text="{Binding LoginPassword}" />
                            <Button Grid.Column="1"
                                    Text="{Binding LoginPasswordToggleText}"
                                    Command="{Binding ToggleLoginPasswordCommand}"
                                    Padding="10,6"
                                    BackgroundColor="Transparent" />
                        </Grid>
                    </VerticalStackLayout>

                    <!-- Remember + Forgot -->
                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                        <CheckBox IsChecked="{Binding RememberMe}" />
                        <Label Text="Remember me" VerticalTextAlignment="Center" />
                        <Button Grid.Column="1"
                                Text="Forgot password?"
                                BackgroundColor="Transparent"
                                Command="{Binding ForgotPasswordCommand}" />
                    </Grid>

                    <!-- Validation / Status -->
                    <Label Text="{Binding LoginStatusMessage}" TextColor="Tomato" IsVisible="{Binding HasLoginError}" />

                    <!-- Login Button -->
                    <Button Text="Sign In"
                            Command="{Binding LoginCommand}"
                            IsEnabled="{Binding CanLogin}"
                            CornerRadius="12"
                            HeightRequest="48" />

                    <!-- Divider -->
                    <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="8" Padding="0,4">
                        <BoxView Grid.Column="0" HeightRequest="1" BackgroundColor="#CCCCCC" />
                        <Label Grid.Column="1" Text="or" Opacity="0.6" />
                        <BoxView Grid.Column="2" HeightRequest="1" BackgroundColor="#CCCCCC" />
                    </Grid>

                    <!-- Social logins (optional placeholders) -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Button Text="Continue with Google"
                                Command="{Binding GoogleSignInCommand}" />
                        <Button Grid.Column="1" Text="Continue with Apple"
                                Command="{Binding AppleSignInCommand}" />
                    </Grid>

                    <!-- Create account hint -->
                    <HorizontalStackLayout HorizontalOptions="Center">
                        <Label Text="New here?" />
                        <Button Text="Create an account"
                                BackgroundColor="Transparent"
                                Command="{Binding GoToRegisterTabCommand}" />
                    </HorizontalStackLayout>

                    <!-- Busy overlay -->
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
                </VerticalStackLayout>
            </Frame>
        </Grid>
    </ContentPage>

    <!-- REGISTER TAB -->
    <ContentPage Title="Register">
        <ScrollView>
            <Grid Padding="24" RowDefinitions="Auto,Auto,*" BackgroundColor="{AppThemeBinding Light=#F6F6F6, Dark=#121212}">
                <!-- Header -->
                <VerticalStackLayout Spacing="4">
                    <Label Text="Create account" FontSize="28" FontAttributes="Bold" />
                    <Label Text="Join us in a minute" Opacity="0.7" />
                </VerticalStackLayout>

                <!-- Card -->
                <Frame Grid.Row="1" Padding="20" CornerRadius="16" HasShadow="True" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">
                    <VerticalStackLayout Spacing="16">

                        <!-- Name -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Full name" FontAttributes="Bold" />
                            <Entry Placeholder="Jane Doe" Text="{Binding RegisterName}" ClearButtonVisibility="WhileEditing" />
                        </VerticalStackLayout>

                        <!-- Email -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Email" FontAttributes="Bold" />
                            <Entry Placeholder="you@example.com"
                                   Keyboard="Email"
                                   Text="{Binding RegisterEmail}"
                                   ClearButtonVisibility="WhileEditing" />
                        </VerticalStackLayout>

                        <!-- Password -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Password" FontAttributes="Bold" />
                            <Grid ColumnDefinitions="*,Auto">
                                <Entry Placeholder="At least 8 characters"
                                       IsPassword="{Binding IsRegisterPasswordHidden, Mode=TwoWay}"
                                       Text="{Binding RegisterPassword}" />
                                <Button Grid.Column="1"
                                        Text="{Binding RegisterPasswordToggleText}"
                                        Command="{Binding ToggleRegisterPasswordCommand}"
                                        BackgroundColor="Transparent"
                                        Padding="10,6" />
                            </Grid>
                        </VerticalStackLayout>

                        <!-- Confirm Password -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Confirm password" FontAttributes="Bold" />
                            <Entry Placeholder="Re-enter password"
                                   IsPassword="True"
                                   Text="{Binding RegisterConfirmPassword}" />
                        </VerticalStackLayout>

                        <!-- Terms -->
                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <CheckBox IsChecked="{Binding AcceptTerms}" />
                            <Label>
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="I agree to the " />
                                        <Span Text="Terms of Service" TextDecorations="Underline">
                                            <Span.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding OpenTermsCommand}" />
                                            </Span.GestureRecognizers>
                                        </Span>
                                        <Span Text=" and " />
                                        <Span Text="Privacy Policy" TextDecorations="Underline">
                                            <Span.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding OpenPrivacyCommand}" />
                                            </Span.GestureRecognizers>
                                        </Span>
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </HorizontalStackLayout>

                        <!-- Validation / Status -->
                        <Label Text="{Binding RegisterStatusMessage}" TextColor="Tomato" IsVisible="{Binding HasRegisterError}" />

                        <!-- Register Button -->
                        <Button Text="Create Account"
                                Command="{Binding RegisterCommand}"
                                IsEnabled="{Binding CanRegister}"
                                CornerRadius="12"
                                HeightRequest="48" />

                        <!-- Already have account -->
                        <HorizontalStackLayout HorizontalOptions="Center">
                            <Label Text="Already have an account?" />
                            <Button Text="Sign in"
                                    BackgroundColor="Transparent"
                                    Command="{Binding GoToLoginTabCommand}" />
                        </HorizontalStackLayout>

                        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
                    </VerticalStackLayout>
                </Frame>

                <!-- Spacer to avoid clipping on small screens -->
                <BoxView Grid.Row="2" HeightRequest="40" Opacity="0" />
            </Grid>
        </ScrollView>
    </ContentPage>

</TabbedPage>
